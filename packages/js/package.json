{
  "name": "kubi-sdk",
  "version": "1.0.0",
  "description": "Control the Kubi 2.0 tablet stand (two-axis pan/tilt) over Web Bluetooth: connect, move the neck, read its position and device status.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iPreTeam-Innovate/kubi-sdk.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/iPreTeam-Innovate/kubi-sdk#readme",
  "bugs": "https://github.com/iPreTeam-Innovate/kubi-sdk/issues",
  "author": "iPresence Co., Ltd.",
  "contributors": ["TAKAHIRO OTA","KATO YUTA","KAZUTAKA HAYASHI"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "keywords": [
    "kubi",
    "bluetooth",
    "ble",
    "web-bluetooth",
    "robot",
    "pan-tilt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsx ../../tool/check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-bluetooth": "^0.0.20",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
